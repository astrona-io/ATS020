# Pinned versions for the course content. This file is the single source of
# truth: Renovate updates the values here, then scripts/sync-versions.py
# writes them into the pages, manifests, lab configs and bootstrap scripts.
#
# Write every value without a leading "v". The sync script adds the "v" where
# a file needs it (image tags, release URLs).
#
# A new version can change command output on the pages. Merge a bump only
# after the affected labs pass `astrona test` and the page output is checked.
#
# Synced paths: sections README.md astrona.yaml
#
# A value without a "# renovate:" comment is set by another tool (the
# kube-prometheus-stack chart, the Argo CD install manifest, an astrona addon).
# Update it by hand together with that tool, from the images it really runs.

# Kubernetes node image for kind. The exam runs Kubernetes 1.35, so Renovate
# only proposes patch releases of 1.35.
# renovate: datasource=docker depName=kindest/node extractVersion=^v(?<version>.*)$
KIND_NODE_VERSION=1.35.8

# renovate: datasource=github-releases depName=cert-manager/cert-manager extractVersion=^v(?<version>.*)$
CERT_MANAGER_VERSION=1.21.3

# renovate: datasource=github-releases depName=open-telemetry/opentelemetry-operator extractVersion=^v(?<version>.*)$
OTEL_OPERATOR_VERSION=0.162.0

# Collector contrib image; telemetrygen is released with the same version.
# renovate: datasource=docker depName=otel/opentelemetry-collector-contrib
OTEL_COLLECTOR_VERSION=0.165.0

# renovate: datasource=docker depName=jaegertracing/jaeger
JAEGER_VERSION=2.23.0

# renovate: datasource=docker depName=ghcr.io/stefanprodan/podinfo
PODINFO_VERSION=6.17.0

# renovate: datasource=docker depName=curlimages/curl
CURL_VERSION=8.23.0

# Python trace emitter image.
# renovate: datasource=docker depName=python versioning=docker
PYTHON_IMAGE_TAG=3.13.18-alpine3.24

# relay (Node.js) image. A floating tag on purpose: it follows the major line.
# renovate: datasource=docker depName=node versioning=docker
NODE_IMAGE_TAG=22-alpine

# go-httpbin (probe).
# renovate: datasource=docker depName=mccutchen/go-httpbin
GO_HTTPBIN_VERSION=2.25.0

# Helm, used by the bootstrap scripts to install charts.
# renovate: datasource=github-releases depName=helm/helm extractVersion=^v(?<version>.*)$
HELM_VERSION=4.3.2

# kube-prometheus-stack Helm chart. A new chart version brings new images:
# after a bump, set the six values below to the images the chart installs.
# renovate: datasource=helm depName=kube-prometheus-stack registryUrl=https://prometheus-community.github.io/helm-charts
KUBE_PROMETHEUS_STACK_VERSION=92.22.0
PROMETHEUS_VERSION=3.15.0
PROMETHEUS_OPERATOR_VERSION=0.94.1
ALERTMANAGER_VERSION=0.34.1
GRAFANA_VERSION=13.2.3
K8S_SIDECAR_VERSION=2.14.1
KUBE_WEBHOOK_CERTGEN_VERSION=1.8.9

# Loki (section 020, module 30).
# renovate: datasource=docker depName=grafana/loki
LOKI_VERSION=3.7.10

# Argo CD (section 040). Its install manifest brings Redis: after a bump, set
# ARGOCD_REDIS_VERSION to the Redis image of the new manifest.
# renovate: datasource=github-releases depName=argoproj/argo-cd extractVersion=^v(?<version>.*)$
ARGOCD_VERSION=3.6.1
ARGOCD_REDIS_VERSION=8.2.3

# Gitea (section 040, plumbing only).
# renovate: datasource=docker depName=gitea/gitea versioning=docker
GITEA_VERSION=28.3.0

# metrics-server comes from the astrona metricsServer addon (section 050).
METRICS_SERVER_VERSION=0.9.0
